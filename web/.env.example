# Local development and Railway. Copy to .env.local for local work.
# Generate AUTH_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-value
AUTH_TRUST_HOST=true
# Public origin used for the Entra callback URL. Set this to the Railway domain.
# AUTH_URL=https://your-app.up.railway.app
# Optional: explicit origin for printed QR links. Falls back to AUTH_URL, then the
# request host, so production usually needs only AUTH_URL.
# APP_URL=https://your-app.up.railway.app

# MongoDB (Atlas, or a local mongod at mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=offense_tracker

# Microsoft Entra ID (required for real sign-in)
# AUTH_MICROSOFT_ENTRA_ID_ID=<application-client-id>
# AUTH_MICROSOFT_ENTRA_ID_SECRET=<client-secret-value>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<directory-tenant-id>/v2.0

# Rate limiting (in-memory, per app instance, keyed by client IP).
# General pages, route handlers, and server actions.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# Auth.js routes (/api/auth/*).
# AUTH_RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_WINDOW_MS=300000
